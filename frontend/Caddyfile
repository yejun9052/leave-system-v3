# Caddy: HTTPS(또는 HTTP) 종단 + 백엔드로 리버스 프록시
#
# 프론트엔드는 백엔드 jar 안에 번들되어 있으므로, Caddy 는 UI/API 구분 없이
# 모든 요청을 backend 로 넘기고 TLS 만 담당한다.
#
# 접속 주소는 SITE_ADDRESS 로 결정 (도메인 → 자동 HTTPS / :80 → HTTP)
{$SITE_ADDRESS} {
	# 실시간 갱신 연결(SSE)은 압축하면 신호가 모였다가 늦게 가므로 뺀다
	@compress not path /api/realtime
	encode @compress zstd gzip
	reverse_proxy backend:8080 {
		# 접속 IP 는 Caddy 가 쓰는 X-Forwarded-For 로만 알린다. 클라이언트가 넣은 Forwarded 는 지운다(IP 위조 방지)
		header_up -Forwarded
	}
}
