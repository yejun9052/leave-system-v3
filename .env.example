# 이 파일을 복사해서 .env 로 쓰세요.  cp .env.example .env
# .env 는 .gitignore 에 있어 저장소에 올라가지 않습니다. 실제 비밀번호는 .env 에만 둡니다.
#
# 읽는 쪽이 둘입니다.
#   MYSQL_* : docker-compose.yml 이 MySQL 컨테이너를 만들 때 사용
#   DB_*, MAIL_* : Spring 앱이 사용 (application.yaml 의 spring.config.import 로 로드)
# 같은 DB 를 가리키므로 MYSQL_USER 와 DB_USERNAME 등은 값을 맞춰야 합니다.

COMPOSE_PROJECT_NAME=leave-system

# --- MySQL 컨테이너 (docker compose) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=leave
MYSQL_USER=leave
MYSQL_PASSWORD=leave
MYSQL_PORT=3306

# --- Spring 앱 DB 접속 ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=leave
DB_USERNAME=leave
DB_PASSWORD=leave

# --- 단일 시스템 관리자 (발급된 SYS_ADMIN 계정이 전혀 없을 때만 사용) ---
# 계정 담당자의 로그인 ID와 이름을 지정하고, 8자 이상 임의 비밀번호를 넣습니다.
# 최초 발급 후 값을 바꿔 재기동해도 기존 계정의 비밀번호는 변경되지 않습니다.
INITIAL_ADMIN_LOGIN_ID=
INITIAL_ADMIN_OWNER=
INITIAL_ADMIN_PASSWORD=

# --- 메일 발송 ---
# 개발은 개인 Gmail, 배포는 회사 SMTP 를 사용합니다(설계 문서 4장).
# Gmail 은 계정 비밀번호가 아니라 앱 비밀번호를 발급받아 넣습니다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
