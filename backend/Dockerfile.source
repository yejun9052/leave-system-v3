# ---- (대안) 서버에서 소스로 직접 빌드하는 멀티스테이지 방식 ----
# 사용하려면 docker-compose.prod.yml 의 backend.build 에
#   dockerfile: Dockerfile.source  를 지정하면 된다.
FROM gradle:8.11-jdk21 AS build
WORKDIR /workspace
COPY build.gradle.kts ./
COPY src ./src
RUN gradle bootJar --no-daemon -x test

# 재현성 위해 변형 태그 고정(권장: 운영 CI 에서 @sha256:... 다이제스트로 추가 고정)
FROM eclipse-temurin:21-jre-jammy AS runtime
WORKDIR /app
ENV TZ=Asia/Seoul
# curl(healthcheck), pg_dump(DB 백업, PGDG 저장소의 16 버전), /backups 폴더 — Dockerfile 과 같음
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
       https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt jammy-pgdg main" \
       > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 appuser \
    && mkdir -p /backups && chown appuser:appuser /backups
COPY --from=build /workspace/build/libs/*.jar app.jar
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=45s --retries=3 \
  CMD curl -fsS http://localhost:8080/actuator/health || exit 1
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
